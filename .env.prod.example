# Variables del despliegue. Copiar a `.env.prod` en el servidor y rellenar.
#
# `.env.prod` NO va al repositorio: lleva la contraseña de la base, el secreto
# del webhook y la clave del modelo. Esta plantilla si, para que se vea que
# hace falta sin que se vea ninguna.
#
# Los secretos se generan, no se inventan:
#   openssl rand -hex 32

# --- Dominio ---
# El mismo para el tablero, la API y el webhook: un solo origen. Sin https://
DOMINIO=smart-report-sv.duckdns.org

# --- Base de datos ---
POSTGRES_USER=smart_report
POSTGRES_PASSWORD=
POSTGRES_DB=smart_report

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Falla cerrado: sin esto el webhook rechaza todo. Es lo correcto — abrir seria
# aceptar reportes de cualquiera sin enterarse.
TELEGRAM_WEBHOOK_SECRET=

# --- Modelo ---
# El unico costo real del sistema: USD 0,0018 por foto.
ANTHROPIC_API_KEY=
CLASSIFY_MODEL=claude-haiku-4-5

# --- Almacenamiento (Cloudflare R2) ---
# El endpoint es el de la cuenta: https://<id de cuenta>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=
# Desde donde lo alcanza el navegador. Con R2 coincide con el de arriba salvo
# que se use un dominio publico del bucket.
S3_PUBLIC_ENDPOINT_URL=
S3_BUCKET=smart-report-photos
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# --- Sesiones y entrada ---
ENVIRONMENT=production
# Con esto la cookie solo viaja por HTTPS. Cambiarlo rompe la entrada.
SESSION_SECRET=
# Contraseña del usuario de prueba publico. Ese usuario no puede borrar.
DEMO_PASSWORD=

# --- Entrada con Google ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Tiene que coincidir **exacto** con el autorizado en la consola de Google.
OAUTH_REDIRECT_URL=https://smart-report-sv.duckdns.org/auth/google/callback
FRONTEND_URL=https://smart-report-sv.duckdns.org
# Mismo origen: no hay peticiones entre sitios que permitir.
CORS_ORIGINS=https://smart-report-sv.duckdns.org

# --- Direccion escrita ---
GEOCODE_ENABLED=true
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
# La politica del servicio publico exige un contacto real que alguien lea.
GEOCODE_USER_AGENT=smart-report-sv (contacto: )

# --- Detras del proxy ---
# Caddy es el unico salto. Sin esto se usaria su IP para el limite por IP, y
# todo el mundo compartiria el mismo cubo.
TRUSTED_PROXY_HOPS=1
