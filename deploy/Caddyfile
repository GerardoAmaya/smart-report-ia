# Un solo origen para el tablero y la API.
#
# No es comodidad: con origenes distintos hay que configurar CORS y la cookie
# de sesion viaja entre sitios, que son dos fuentes de fallos que solo
# aparecen en produccion. Aqui el navegador solo conoce un dominio.

{$DOMINIO} {
	encode gzip

	# Lo que atiende la API. El resto —incluido todo lo que Next sirve— va al
	# tablero. Se enumeran las rutas de la API y no al reves: una ruta nueva
	# del tablero no deberia exigir tocar el proxy.
	@api path /health /auth/* /board/* /webhooks/* /public/*
	reverse_proxy @api api:8000 {
		# El tablero en vivo es un flujo que no termina: sin esto Caddy
		# esperaria la respuesta completa y no entregaria nada.
		flush_interval -1
	}

	reverse_proxy web:3000

	header {
		# El navegador no vuelve a hablar por HTTP con este dominio.
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		X-Frame-Options "DENY"

		# De donde puede cargar cosas la pagina. Si alguien lograra meter un
		# <script> en el tablero —por un texto de un reporte mal escapado, por
		# ejemplo—, el navegador no lo cargaria de ningun otro sitio ni le
		# dejaria mandar datos fuera. Solo se permite lo que el tablero usa:
		#   - teselas, estilos y tipografias del mapa: tiles.openfreemap.org
		#   - fotos firmadas: el bucket de R2
		#   - fotos de perfil de Google: *.googleusercontent.com
		#   - el worker de MapLibre se sirve desde aqui y crea blobs
		# 'unsafe-inline' en scripts porque Next hidrata con scripts en linea y
		# el tema se aplica antes de pintar con otro; quitarlo exige nonces por
		# peticion, que hacen dinamica cada pagina. Aun asi bloquea scripts de
		# cualquier otro origen, que es lo que importa.
		# Antes de aplicarla corrio en modo solo-informe y se recorrio el tablero
		# entero en produccion: el unico aviso era Zod compilando validadores con
		# new Function, apagado en lib/api.ts. Si se agrega un servicio externo
		# (otro mapa, una fuente), hay que sumarlo aqui o el navegador lo bloquea.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://*.r2.cloudflarestorage.com https://*.googleusercontent.com https://tiles.openfreemap.org; font-src 'self' data:; connect-src 'self' https://tiles.openfreemap.org; worker-src 'self' blob:; child-src 'self' blob:; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"

		# Lo que la pagina no necesita, apagado: si algo intentara usar la
		# camara o la ubicacion desde el tablero, el navegador ni preguntaria.
		# Subir la foto del arreglo usa el selector de archivos del sistema, que
		# no pasa por estos permisos.
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	log {
		output file /data/acceso.log {
			roll_size 10MiB
			roll_keep 5
		}
	}
}
