# Copiar a .env. Nunca commitear .env.
POSTGRES_USER=smart_report
POSTGRES_PASSWORD=smart_report
POSTGRES_DB=smart_report

# La usa el backend dentro de compose (host "db").
DATABASE_URL=postgresql+psycopg://smart_report:smart_report@db:5432/smart_report

# Sin llave, /health reporta el modelo caido y el servicio queda degradado.
ANTHROPIC_API_KEY=

# --- Clasificacion ---
# Por defecto el modelo mas capaz. Cual conviene se decide con la medicion
# de la fase 3, no de memoria. Alternativas: claude-sonnet-5, claude-haiku-4-5
CLASSIFY_MODEL=claude-haiku-4-5
# original o thumbnail. La miniatura cuesta ~35% menos en tokens; si pierde
# acierto se sabra con el conjunto etiquetado.
CLASSIFY_IMAGE_VARIANT=thumbnail

# --- Telegram ---
# Lo da @BotFather. Quien lo tenga es el bot: no compartirlo ni loguearlo.
TELEGRAM_BOT_TOKEN=

# Cadena propia, no la da Telegram. Se registra con setWebhook y Telegram la
# devuelve en cada update. Sin ella el webhook acepta cualquier POST.
# Generar con:  openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET=

# --- Almacenamiento de objetos ---
# MinIO en local. Al desplegar, apuntar a R2 y cambiar solo estas variables:
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com
S3_ENDPOINT_URL=http://minio:9000
# Desde donde lo alcanza el navegador, que corre en el host y no dentro de
# compose. Al desplegar contra R2 los dos valores coinciden.
S3_PUBLIC_ENDPOINT_URL=http://localhost:9000
S3_BUCKET=smart-report-photos
S3_ACCESS_KEY_ID=smart_report_minio
S3_SECRET_ACCESS_KEY=smart_report_minio_dev_only
S3_REGION=us-east-1

ENVIRONMENT=dev

# --- Entrada al tablero ---
# Firma la cookie de sesion. Obligatoria en produccion; en local se genera una
# al vuelo y las sesiones se pierden en cada reinicio.
#   openssl rand -hex 32
SESSION_SECRET=

# Quien puede entrar lo decide la tabla users, no Google. Estos correos se
# siembran como administradores. Separados por coma si hay varios.
ADMIN_EMAIL=

# Entrada con Google. Vacios = apagada, y solo funciona el usuario de prueba.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Usuario de prueba, abierto al publico. Puede asignar, agrupar y cerrar;
# NO puede borrar. Sin contraseña, ese usuario no existe.
DEMO_EMAIL=demo@smart-report.local
DEMO_PASSWORD=
